# PostgreSQL connection string used by Prisma (see prisma/schema.prisma).
#
# Any Postgres works: a free Neon/Supabase/Railway database, or the local
# docker-compose database (`docker compose up -d`) at the URL below.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://backyard:backyard@localhost:5432/backyard?schema=public"

# The variables below are managed by the Shopify CLI (`shopify app dev`).
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=
