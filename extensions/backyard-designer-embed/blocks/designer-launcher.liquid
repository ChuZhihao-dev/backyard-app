{%- assign designer_url = '/apps/backyard-designer' -%}
{%- assign launch_label = block.settings.button_label -%}
{%- if launch_label == blank -%}
  {%- assign launch_label = 'backyard_designer.launcher.button_label' | t -%}
{%- endif -%}

<div
  class="by-designer"
  data-by-designer
  data-position="{{ block.settings.button_position }}"
  data-open-in="{{ block.settings.open_in }}"
  data-url="{{ designer_url }}"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="by-designer__button"
    style="--by-accent: {{ block.settings.accent_color }};"
    data-by-designer-open
  >
    <svg class="by-designer__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path d="M12 2 2 7l10 5 10-5-10-5Zm0 7.24L5.35 6 12 3.76 18.65 6 12 9.24ZM2 12l10 5 10-5-1.77-.88L12 14.48 3.77 11.12 2 12Zm0 5 10 5 10-5-1.77-.88L12 19.48 3.77 16.12 2 17Z" fill="currentColor"/>
    </svg>
    <span class="by-designer__label">{{ launch_label | escape }}</span>
  </button>

  <dialog
    class="by-designer-dialog"
    data-by-designer-dialog
    aria-label="{{ 'backyard_designer.dialog.title' | t | escape }}"
  >
    <div class="by-designer-dialog__panel">
      <button
        type="button"
        class="by-designer-dialog__close"
        data-by-designer-close
        aria-label="{{ 'backyard_designer.dialog.close' | t | escape }}"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <iframe
        class="by-designer-dialog__frame"
        data-by-designer-frame
        title="{{ 'backyard_designer.dialog.frame_title' | t | escape }}"
        loading="lazy"
        allow="clipboard-read; clipboard-write; fullscreen"
      ></iframe>
    </div>
  </dialog>
</div>

{% schema %}
{
  "name": "Designer launcher",
  "target": "body",
  "stylesheet": "designer-launcher.css",
  "javascript": "designer-launcher.js",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Button position",
      "default": "bottom-right",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1f5f45"
    },
    {
      "type": "select",
      "id": "open_in",
      "label": "Open the designer in",
      "default": "overlay",
      "options": [
        { "value": "overlay", "label": "Overlay" },
        { "value": "new_tab", "label": "New tab" }
      ]
    }
  ]
}
{% endschema %}
